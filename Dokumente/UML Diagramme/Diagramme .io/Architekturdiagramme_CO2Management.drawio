        </mxCell>
        <mxCell id="logik" value="&lt;b&gt;Geschäftslogikschicht (Server – Spring Boot)&lt;/b&gt;&lt;br&gt;Controller (REST-Endpunkte, @PreAuthorize)&lt;br&gt;Service (Geschäftslogik, Standort-Zugriffsprüfung)&lt;br&gt;Security (Spring Security, sitzungsbasierte Auth)&lt;br&gt;DTOs (Records) &amp;nbsp;|&amp;nbsp; GlobalExceptionHandler" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1">
