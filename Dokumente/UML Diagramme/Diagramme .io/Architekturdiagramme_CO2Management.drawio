        <mxCell id="praesentation" value="&lt;b&gt;Präsentationsschicht (Client)&lt;/b&gt;&lt;br&gt;React 18 + Vite (SPA) &amp;nbsp;|&amp;nbsp; React Router &amp;nbsp;|&amp;nbsp; AuthContext / useReducer &amp;nbsp;|&amp;nbsp; Recharts &amp;nbsp;|&amp;nbsp; Axios (HTTP-Client)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1">
